{
  "manifest_version": 3,
  "name": "中西文字体替换",
  "version": "1.5.3",
  "description": "配置共用标点、中文正文及 serif 中西文字体组合，保留网站其余字体列表。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["storage", "fontSettings", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "中西文字体替换设置", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["main-runtime.js"], "run_at": "document_start", "all_frames": true, "match_origin_as_fallback": true, "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["shared.js", "bridge.js"], "run_at": "document_start", "all_frames": true, "match_origin_as_fallback": true }
  ]
}
